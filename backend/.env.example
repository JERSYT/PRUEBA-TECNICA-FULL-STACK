PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/soporte_tecnico_db?schema=public"

# Notificaciones por correo (opcional). Sin SMTP_HOST funciona en modo "log".
NOTIFY_ENABLED=true
NOTIFY_FROM="Mesa de Ayuda <no-reply@soporte.local>"
NOTIFY_TO="mesa-ayuda@example.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
